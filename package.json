{
  "name": "dsh-user-mirror",
  "version": "0.6.1-ru.1",
  "description": "Русская редакция dsh-user-mirror: перевод интерфейса и системного промпта плюс две правки апстрима — awaited запись/удаление памяти и сопоставитель тем, понимающий кириллицу.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danerus23/dsh-user-mirror-ru.git"
  },
  "homepage": "https://github.com/Danerus23/dsh-user-mirror-ru#readme",
  "bugs": {
    "url": "https://github.com/Danerus23/dsh-user-mirror-ru/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "memory",
    "preference",
    "personalization",
    "russian",
    "localization",
    "i18n"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "ai-orb": "^0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-storage-domain": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  }
}
